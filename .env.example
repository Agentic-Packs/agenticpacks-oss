# Database (Local Docker, Neon, Supabase, or Railway)
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/ai_starter_community"

# Auth.js v5 Configuration (AUTH_URL or NEXTAUTH_URL)
AUTH_URL="http://localhost:3000"
AUTH_SECRET="your-32-char-random-secret-run-openssl-rand-hex-32"

# Optional: Google OAuth (Create at https://console.cloud.google.com/apis/credentials)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# OpenAI API Key (Single model: GPT-4o Mini)
OPENAI_API_KEY="sk-..."

# Stripe (in-app Free + Pro $19 / 500 credits). Leave empty to boot without Checkout.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# Stable instance id stamped on Checkout/subscription metadata (not a hostname).
STRIPE_APP_ID="ai-starter-community"
