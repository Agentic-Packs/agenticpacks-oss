# ==============================================================================
# Multi-Stage Production Dockerfile for Next.js 15 (Standalone Output)
# ==============================================================================

# Base Stage: Alpine with required native system dependencies
FROM node:22-alpine AS base
RUN apk add --no-cache libc6-compat openssl
WORKDIR /app

# Stage 1: Package Dependencies
FROM base AS deps
COPY package.json package-lock.json* ./
COPY prisma ./prisma/
RUN npm ci

# Stage 2: Application Builder
FROM base AS builder
COPY --from=deps /app/node_modules ./node_modules
COPY . .

ENV NEXT_TELEMETRY_DISABLED=1
ENV NODE_ENV=production
ENV NODE_OPTIONS="--max-old-space-size=4096"

RUN npx prisma generate
RUN npm run build

# Stage 3: Minimal Production Runner
FROM base AS runner

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3000
ENV HOSTNAME="0.0.0.0"

RUN addgroup --system --gid 1001 nodejs
RUN adduser --system --uid 1001 nextjs

# Set ownership of /app
RUN chown -R nextjs:nodejs /app

USER nextjs

# Copy public assets & standalone build output
COPY --from=builder /app/public ./public
COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./.next/static
COPY --from=builder --chown=nextjs:nodejs /app/prisma ./prisma

# Support for runtime db push & doctor
COPY --chown=nextjs:nodejs package.json ./

# Install prisma & tsx locally for runner runtime scripts
RUN npm install prisma@^6.4.1 --no-save

EXPOSE 3000

# Run prisma db push at runtime to ensure database is created/updated before starting
CMD ["sh", "-c", "npx prisma db push --accept-data-loss --skip-generate && node server.js"]
